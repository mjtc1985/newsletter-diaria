#!/bin/sh
set -eu

UID_NUM="$(id -u)"
CACHE_DIR="${GEMINI_CACHE_DIR:-/var/lib/newsletter-diaria}"
BUN_BIN="${BUN_BIN:-/home/raspberry/.bun/bin/bun}"
BUNDLE="$CACHE_DIR/bunx-${UID_NUM}-@google/gemini-cli@latest/node_modules/@google/gemini-cli/bundle/gemini.js"

if [ ! -f "$BUNDLE" ]; then
  "${HOME}/.bun/bin/bunx" @google/gemini-cli@latest --help >/dev/null 2>&1 || true
fi

exec "$BUN_BIN" "$BUNDLE" "$@"
